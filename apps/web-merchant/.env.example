# ========================================
# MERCHANT APP SPECIFIC ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ========================================




# App Identity
NEXT_PUBLIC_APP_NAME=Encreasl Merchant Portal
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://merchant.encreasl.com

# Merchant portal features
NEXT_PUBLIC_ENABLE_USER_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_ANALYTICS_DASHBOARD=true
NEXT_PUBLIC_ENABLE_CONTENT_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_CAMPAIGN_MANAGEMENT=true

# Security & access control
NEXT_PUBLIC_REQUIRE_2FA=true
NEXT_PUBLIC_SESSION_TIMEOUT=3600
NEXT_PUBLIC_MAX_LOGIN_ATTEMPTS=5

# Development & Debugging
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# ========================================
# API CONFIGURATION - CONSISTENT WITH APPS/WEB
# ========================================

# Central API Base URL - PayloadCMS is our single source of truth for ALL backend operations:
# - Authentication (login, register, user management)
# - User data (profiles, preferences, roles)
# - Content management (posts, media, services)
# - File operations (uploads, media management)
# - Admin operations and dashboard data
# - All business logic and data operations
# Development:
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Production:
NEXT_PUBLIC_API_URL=https://cms.tap2goph.com/api

# Service API key for server-side CMS reads (same key as apps/web
# NEXT_PUBLIC_PAYLOAD_API_KEY). Required so /api/search can populate
# merchant-products.product_id.media.primaryImage — vendor JWTs cannot read
# `products` on production CMS, so without this key product thumbnails fall
# back to the placeholder icon. Server prefers PAYLOAD_API_KEY, falls back to
# NEXT_PUBLIC_PAYLOAD_API_KEY.
# PAYLOAD_API_KEY=your_service_api_key_here
# NEXT_PUBLIC_PAYLOAD_API_KEY=your_service_api_key_here

# Database Access (Admin only)
ADMIN_DATABASE_URL=postgresql://username:password@localhost:5432/encreasl_admin
ADMIN_DATABASE_POOL_SIZE=10

# Third-party Admin Services
ADMIN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ADMIN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Monitoring & Logging
ADMIN_LOG_LEVEL=info
ADMIN_ENABLE_AUDIT_LOGS=true

# Email Notifications (Admin)
ADMIN_NOTIFICATION_EMAIL=admin@encreasl.com
ADMIN_ALERT_EMAIL=alerts@encreasl.com

# Development
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# Security Headers
ADMIN_ENABLE_CSP=true
ADMIN_ENABLE_HSTS=true
