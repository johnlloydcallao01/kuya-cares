{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@encreasl/cms",
  "version": "0.1.0",
  "description": "Encreasl CMS powered by PayloadCMS 3.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true npm_config_user_agent=npm NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build --webpack && node scripts/prepare-standalone.mjs && node scripts/materialize-hoisted-peers.mjs && node scripts/self-contain-standalone.mjs",
    "postinstall": "node scripts/materialize-hoisted-peers.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_ENV=production HOSTNAME=0.0.0.0 NODE_OPTIONS=--no-deprecation node .next/standalone/apps/cms/server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "db:test": "node test-db-connection.js"
  },
  "dependencies": {
    "@encreasl/cache": "workspace:*",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@next/swc-wasm-nodejs": "16.3.2",
    "@swc/helpers": "0.5.23",
    "@payloadcms/db-postgres": "3.49.0",
    "@payloadcms/next": "3.49.0",
    "@payloadcms/payload-cloud": "3.49.0",
    "@payloadcms/plugin-cloud-storage": "3.49.0",
    "@payloadcms/richtext-lexical": "3.49.0",
    "@payloadcms/ui": "3.49.0",
    "@supabase/supabase-js": "^2",
    "@types/node": "^22.5.4",
    "@types/react": "~19.0.10",
    "@types/react-dom": "19.1.0",
    "@upstash/redis": "^1.34.3",
    "axios": "^1.7.9",
    "cloudinary": "^2.7.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.44.5",
    "graphql": "^16.8.1",
    "jose": "^5.9.6",
    "next": "16.3.2",
    "node-fetch": "^3.3.2",
    "payload": "3.49.0",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.2",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@encreasl/cms-types": "workspace:*",
    "@encreasl/eslint-config": "workspace:*",
    "@encreasl/typescript-config": "workspace:*",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "1.50.0",
    "@testing-library/react": "16.3.0",
    "@types/minimatch": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "4.5.2",
    "baseline-browser-mapping": "2.11.18",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "26.1.0",
    "playwright": "1.50.0",
    "playwright-core": "1.50.0",
    "prettier": "^3.4.2",
    "turbo": "^2.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.12.3"
  }
}
