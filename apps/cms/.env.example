# Database Configuration
DATABASE_URI=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# Database Connection Pool Configuration (Performance Optimization)
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_ACQUIRE_TIMEOUT=60000
DATABASE_MAX_USES=7500
DATABASE_STATEMENT_TIMEOUT=20000

# Server-side Upstash cache (never expose with NEXT_PUBLIC_)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Payload CMS Configuration
PAYLOAD_SECRET=<YOUR_PAYLOAD_SECRET>

# PayloadCMS API (server-to-server)
PAYLOAD_API_KEY=<YOUR_PAYLOAD_API_KEY>
PAYLOAD_API_URL=<YOUR_PAYLOAD_API_URL>

# Environment
NODE_ENV=development

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Cloudinary Configuration (Client-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>

# Cloudinary Configuration (Server-side)
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# For CORS Reference of allowed URLS

# Local URLs  
ADMIN_LOCAL_URL=http://localhost:3002
WEB_LOCAL_URL=http://localhost:3000
CMS_LOCAL_URL=http://localhost:3001
WEB_DRIVER_LOCAL_URL=http://localhost:3004
MOBILE_CUSTOMER_LOCAL_URL=http://localhost:8081

# Production URLs  
ADMIN_PROD_URL=https://admin.yourdomain.com
WEB_PROD_URL=https://app.yourdomain.com
CMS_PROD_URL=https://cms.yourdomain.com
MERCHANT_PROD_URL=https://merchant.yourdomain.com

# Cookie Configuration
COOKIE_DOMAIN=.yourdomain.com

# Resend Email Configuration
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=no-reply@yourdomain.com
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_FROM_NAME=Tap2Go
EMAIL_REPLY_TO=no-reply@yourdomain.com

# PayMongo Configuration
PAYMONGO_SANDBOX=false
PAYMONGO_PUBLIC_KEY_LIVE=<YOUR_PAYMONGO_PUBLIC_KEY_LIVE>
PAYMONGO_SECRET_KEY_LIVE=<YOUR_PAYMONGO_SECRET_KEY_LIVE>
PAYMONGO_SANDBOX_API_KEY=<YOUR_PAYMONGO_SANDBOX_API_KEY>
PAYMONGO_WEBHOOK_SECRET=<YOUR_PAYMONGO_WEBHOOK_SECRET>
PAYMONGO_SANDBOX_WEBHOOK_SECRET=<YOUR_PAYMONGO_SANDBOX_WEBHOOK_SECRET>

# Lalamove Configuration
LALAMOVE_SANDBOX=false
LALAMOVE_API_KEY=<YOUR_LALAMOVE_API_KEY>
LALAMOVE_API_SECRET=<YOUR_LALAMOVE_API_SECRET>
LALAMOVE_SANDBOX_API_KEY=<YOUR_LALAMOVE_SANDBOX_API_KEY>
LALAMOVE_SANDBOX_API_SECRET=<YOUR_LALAMOVE_SANDBOX_API_SECRET>
LALAMOVE_MARKET=PH
# Priority fee (tip) automatically applied to every delivery to speed up rider
# matching. Set to 0 to disable. PH minimum is typically PHP 20.
LALAMOVE_PRIORITY_FEE=20

# Password reset
RESET_PASSWORD_BASE_URL=https://app.yourdomain.com
RESET_PASSWORD_TTL_MINUTES=20

# Vercel Integration (Maintenance Mode)
VERCEL_API_TOKEN=<YOUR_VERCEL_API_TOKEN>
VERCEL_EDGE_CONFIG_ID=<YOUR_EDGE_CONFIG_ID>
VERCEL_TEAM_ID=<YOUR_TEAM_ID_OPTIONAL>
